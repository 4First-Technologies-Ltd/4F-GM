# Public base URL of the gas-monitor-backend API (Express + Prisma).
# Local: http://localhost:9000
# Production: https://ugo.4fgmonitor.com
NEXT_PUBLIC_API_URL=http://localhost:9000

# Sentry (optional, mirrors gas-monitor-web)
NEXT_PUBLIC_SENTRY_DSN=

