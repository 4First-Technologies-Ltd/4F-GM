generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CONSUMER
  VENDOR
  RIDER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Riders are approved independently of vendors — a rider isn't owned by any
/// one vendor, so this can't just reuse VendorStatus.
enum RiderStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Marketplace partner plans. The commission rate each one carries lives in
/// `src/lib/plans.ts` — the enum is only the identity of the plan.
enum VendorPlan {
  BASIC
  GROWTH
  PRO
}

enum GasType {
  COOKING
  MEDICAL
  INDUSTRIAL
  BULK
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
}

enum UnitPreference {
  KG
  LBS
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String
  phone             String?
  devicePhone       String?
  avatarUrl         String?
  password          String
  role              Role              @default(CONSUMER)
  emailVerified     Boolean           @default(false)
  isSuspended       Boolean           @default(false)
  otpCodeHash       String?
  otpPurpose        OtpPurpose?
  otpExpiresAt      DateTime?
  otpAttempts       Int               @default(0)
  pushEnabled       Boolean           @default(true)
  emailNotifEnabled Boolean           @default(true)
  smsAlertsEnabled  Boolean           @default(false)
  unitPreference    UnitPreference    @default(KG)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  refreshTokens     RefreshToken[]
  vendorProfile     VendorProfile?
  riderProfile      RiderProfile?
  orders            Order[]           @relation("ConsumerOrders")
  cylinderProfiles  CylinderProfile[]
  addresses         Address[]
  legalAcceptances  LegalAcceptance[]

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  fullAddress String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model VendorProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessAddress String
  /// Nigerian state and city the vendor trades from. Nullable only because
  /// vendors created before these were collected have neither.
  state           String?
  city            String?
  bio             String?
  logoUrl         String?
  lat             Float?
  lng             Float?
  phone           String
  status          VendorStatus     @default(PENDING)
  /// Partner plan the vendor sells under. New vendors pick one at sign-up;
  /// BASIC is the default only so pre-existing rows backfill sensibly.
  plan            VendorPlan       @default(BASIC)
  /// When the plan last changed. Null for vendors who never switched.
  planChangedAt   DateTime?
  /// Cooldown expiry: the vendor cannot switch again until this passes.
  /// Stored rather than derived so changing the cooldown length later does
  /// not retroactively move locks vendors were already promised.
  planLockedUntil DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       VendorDocument[]
  listings        GasListing[]
  orders          Order[]            @relation("VendorOrders")
  planChanges     VendorPlanChange[]

  @@map("vendor_profiles")
}

/// Who moved a vendor between plans. Vendor-initiated switches have no actor
/// details; admin ones snapshot the operator so the row survives their deletion.
enum PlanChangeActor {
  VENDOR
  ADMIN
}

/// Append-only record of every partner-plan move. `audit_logs` covers admin
/// actions across the platform; this is the per-vendor commercial history,
/// including the switches vendors make themselves.
model VendorPlanChange {
  id         String          @id @default(uuid())
  vendorId   String
  vendor     VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fromPlan   VendorPlan
  toPlan     VendorPlan
  actor      PlanChangeActor
  /// Operator name for ADMIN changes, null when the vendor did it themselves.
  actorName  String?
  actorEmail String?
  /// True when an operator overrode a cooldown that was still running.
  bypassedCooldown Boolean   @default(false)
  createdAt  DateTime        @default(now())

  @@index([vendorId, createdAt])
  @@map("vendor_plan_changes")
}

model VendorDocument {
  id        String        @id @default(uuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  createdAt DateTime      @default(now())

  @@map("vendor_documents")
}

/// Delivery agents for marketplace orders. Not owned by a vendor — a rider
/// can be assigned to any vendor's order, so this sits alongside
/// VendorProfile rather than under it.
model RiderProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  vehicleType String?
  plateNumber String?
  lat         Float?
  lng         Float?
  status      RiderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]     @relation("RiderOrders")

  @@map("rider_profiles")
}

model GasListing {
  id            String        @id @default(uuid())
  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  gasType       GasType
  customName    String?
  pricePerKg    Float
  cylinderSizes String[]
  otherSizes    String?
  inStock       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]

  @@map("gas_listings")
}

model CylinderProfile {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  sizeKg          Float
  customSizeLabel String?
  imageKey        String   @default("12.5kg")
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cylinder_profiles")
}

model Order {
  id              String         @id @default(uuid())
  consumerId      String
  consumer        User           @relation("ConsumerOrders", fields: [consumerId], references: [id])
  vendorId        String?
  vendor          VendorProfile? @relation("VendorOrders", fields: [vendorId], references: [id])
  listingId       String?
  listing         GasListing?    @relation(fields: [listingId], references: [id])
  riderId         String?
  rider           RiderProfile?  @relation("RiderOrders", fields: [riderId], references: [id])
  /// Set when a rider is assigned, cleared if unassigned. Distinct from
  /// createdAt/updatedAt so "how long has this sat unassigned" is answerable.
  assignedAt      DateTime?
  supplierName    String?
  cylinderSize    String
  quantity        Int
  totalAmount     Float
  deliveryAddress String
  status          OrderStatus    @default(PENDING)
  paystackRef     String?        @unique
  paystackStatus  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("orders")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model PlatformSettings {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  allowVendorSignups Boolean  @default(true)
  supportEmail       String?
  platformFeePercent Float    @default(0)
  /// 4FG Monitor, sold by 4First direct. Whole naira. The backend prices
  /// monitor orders from these; the web only displays them.
  monitorUnitPrice   Int      @default(45000)
  monitorDeliveryFee Int      @default(2000)
  monitorMinQuantity Int      @default(10)
  updatedAt          DateTime @updatedAt

  @@map("platform_settings")
}

enum AuditAction {
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_STATUS_RESET
  RIDER_APPROVED
  RIDER_REJECTED
  RIDER_STATUS_RESET
  ORDER_RIDER_ASSIGNED
  ORDER_RIDER_UNASSIGNED
  LISTING_STOCK_UPDATED
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
  ADMIN_CREATED
  ADMIN_UPDATED
  ADMIN_DEACTIVATED
  ADMIN_DELETED
  SETTINGS_UPDATED
  VENDOR_PLAN_CHANGED
  ADMIN_LOGIN
  ADMIN_LOGIN_FAILED
}

// Append-only record of every mutating admin action.
//
// Actor fields are deliberately DENORMALISED rather than a relation to
// AdminUser: the log must survive the admin being deleted, and the env-var root
// account ("root") has no admin_users row at all.
model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  actorName  String
  actorEmail String
  actorRole  AdminRole
  action     AuditAction
  resource   String
  resourceId String?
  summary    String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

enum LegalDocument {
  TERMS
  PRIVACY
}

/// Append-only record that a user accepted a version of a legal document.
model LegalAcceptance {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   LegalDocument
  version    String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime      @default(now())

  @@unique([userId, document, version])
  @@index([userId])
  @@map("legal_acceptances")
}
