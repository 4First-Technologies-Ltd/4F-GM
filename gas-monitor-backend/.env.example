# Server
PORT=9000
NODE_ENV=development
# Comma-separated list of allowed browser origins (web + admin frontends, plus local dev ports).
# Production: https://4fgmonitor.com,https://4fgmpanel.4fgmonitor.com
# This var isn't set from the repo — it must also be set directly in the
# Render service's environment for the deployed backend to actually allow these origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3010

# Database (same Supabase Postgres instance used by gas-monitor-web / gas-monitor-admin today)
DATABASE_URL=
DIRECT_URL=

# Consumer/vendor auth (bearer access + refresh tokens)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin auth (cookie session) — separate scheme/secret from the above, kept as-is
ADMIN_JWT_SECRET=
ADMIN_SESSION_EXPIRES_IN=12h
# Bootstrap super-admin login (env-based, in addition to DB-backed AdminUser accounts)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email (Resend) — used for OTP emails; if unset, OTPs are logged to the console instead
EMAIL_FROM="4FG Smart Gas Monitor <onboarding@resend.dev>"
# Sender for newsletter mail (confirmation + issues); domain must be verified in Resend.
NEWSLETTER_FROM="4FG Smart Gas Monitor <newsletters@notifications.4fgmonitor.com>"
# Where replies to newsletter mail go.
NEWSLETTER_REPLY_TO=4fgmonitor@gmail.com
RESEND_API_KEY=

# Paystack
PAYSTACK_SECRET_KEY=

# Marketing email
# Public origin of this API, used in unsubscribe links.
API_PUBLIC_URL=https://ugo.4fgmonitor.com
# Optional: HMAC key for unsubscribe links (falls back to ADMIN_JWT_SECRET). Changing it invalidates old links.
UNSUBSCRIBE_SECRET=

# Ops briefing (Telegram bot shared with the Sentry alert webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PANEL_URL=https://4fgmpanel.4fgmonitor.com
# The website, used for links in emails (branch-manager invites).
WEB_APP_URL=https://4fgmonitor.com
# OPS_BRIEFING_ENABLED=false

# Waitlist (Supabase project the landing page writes to). The service-role key
# bypasses RLS — server-side only, never expose it to a browser.
SUPABASE_URL=https://mhkhwlyfsulvhenwooef.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Vendor document storage (Cloudflare R2, private bucket) ─────────────────
# Create a bucket with public access OFF, then an API token with Object Read & Write
# scoped to that bucket. The app uploads straight to R2 on a 5-minute signed link, so
# the bucket needs a CORS rule allowing PUT from any origin with header Content-Type
# (mobile uploads send no Origin; the rule only matters for browser uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Admin two-factor authentication ─────────────────────────────────────────
# Required for every named admin by default. Set to false only to roll back.
# ADMIN_MFA_REQUIRED=true
# Key that encrypts stored TOTP secrets. Falls back to ADMIN_JWT_SECRET; set a
# separate one so rotating the session secret does not lock everyone out of 2FA.
# MFA_ENCRYPTION_KEY=
# Optional second factor for the shared env login (base32 secret). Better: set
# ADMIN_ROOT_LOGIN_DISABLED=true once a named super admin has enrolled.
# ADMIN_ROOT_TOTP_SECRET=
