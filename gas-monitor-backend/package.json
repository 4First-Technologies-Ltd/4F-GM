{
  "name": "gas-monitor-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim:broker": "tsx tools/device-simulator/dev-broker.ts",
    "sim:device": "tsx tools/device-simulator/simulator.ts",
    "sim:cli": "tsx tools/device-simulator/cli.ts",
    "sim:check": "tsx tools/device-simulator/check.ts",
    "worker:ingest": "tsx src/workers/ingest.ts",
    "worker:ingest:prod": "node dist/workers/ingest.js",
    "device:provision": "tsx tools/provision-device.ts",
    "sim:e2e": "tsx tools/device-simulator/e2e.ts",
    "sim:api": "tsx tools/device-simulator/dev-api.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.67.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "resend": "^6.17.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "aedes": "^1.2.0",
    "mqtt": "^5.16.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
